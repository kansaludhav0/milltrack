APP_NAME=MillTrack
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Postgres connection string (use the direct connection, not the pooler,
# unless you've deliberately handled PgBouncer transaction-mode statement caching).
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Long random string — signs every issued JWT. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=12
MAX_PIN_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# S3 bucket for gate photos; EC2 instance should reach it via an IAM instance role,
# not static keys, so no AWS access key/secret belongs in this file.
S3_BUCKET=milltrack-gate-photos
AWS_REGION=ap-south-1
